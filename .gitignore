# Checkpoints (large binary files, ~28 GB)
ckpts/

# Experiment logs (generated by training runs)
gqe_experiments/*

# SLURM output logs
slurm_logs/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Large pipeline diagrams (not paper figures)
gqe_qcbm_diffusion_pipeline*.png
diagram_architecture.png
diagram_results.png
diagram_training_methods.png

# Reference PDFs (exclude all except the paper's figures)
*.pdf
!paper/figs/*.pdf
!paper/figs/**/*.pdf

# Old run directories
run_2026*/

# Datasets and generated outputs
dataset/
dataset_fwd/
outputs/
prefix_circuits/
dqas_results/
gqe_gaussian_results/

# Ad-hoc backups and local-only archive (never commit)
*.backup-*
*.backup
*_backup.tex
_local_archive/

# Misc
*.egg-info/
.env

# Machine-local: Claude Code marker, session digests, editor and OS files
.claude/
.ccid
/logs/
.DS_Store
._*
.ipynb_checkpoints/
.venv/
.vscode/
.idea/
*.swp

# SLURM stdout/stderr and stray logs anywhere in the tree
*.out
*.log

# Training logs read directly by a paper figure (make_15q_Nsweep.py)
!gqe_experiments/15q_N*/

# Re-generated alongside the paper PDFs when the make_*.py scripts run
paper/figs/**/*.png
paper/figs/fig_circuits_*_faded.pdf
paper/figs/fig_circuits_*_notesbelow.pdf
# Written by scripts/download_ckpts.py next to ckpts/
/MANIFEST.sha256
